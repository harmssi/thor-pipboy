<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nur für 127.0.0.1 (ThorPipBoy-F4SE-Plugin im Spiel); keine Verbindungen nach außen. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wächter: Foreground-Service, der den Pip-Boy nach einem Low-Memory-Kill unten neu öffnet -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <queries>
        <package android:name="com.droiddeck.launcher" />
    </queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:appCategory="game" android:usesCleartextTraffic="true" android:theme="@style/Theme.PipBoy">
        <!-- Starter: Fallout 4 in DroiDeck oben (Display 0), Pip-Boy unten (Display 4) -->
        <activity android:name=".StarterActivity" android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PipBoyActivity" android:exported="true"
            android:label="@string/pipboy_name" android:launchMode="singleTask"
            android:resizeableActivity="true" android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode" />
        <service android:name=".GuardService" android:process=":guard" android:exported="false" />
    </application>
</manifest>
